# Minecraft connection
MC_USERNAME=your_bot_username
MC_PASSWORD=
MC_AUTH=offline
MC_HOST=play.example.net
MC_PORT=25565
MC_VERSION=

# Reconnection
AUTO_RECONNECT=true
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=120000
CONNECTION_TIMEOUT_MS=120000

# Anti-AFK
ANTI_AFK_ENABLED=true
ANTI_AFK_SNEAK=false

# Movement
MOVEMENT_ENABLED=true
CIRCLE_WALK_ENABLED=true
CIRCLE_WALK_RADIUS=4
CIRCLE_WALK_INTERVAL_MS=3000
LOOK_AROUND_ENABLED=true
LOOK_AROUND_INTERVAL_MS=5000
RANDOM_JUMP_ENABLED=false
RANDOM_JUMP_INTERVAL_MS=10000

# Server authentication plugin (optional)
AUTO_AUTH_ENABLED=false
AUTO_AUTH_PASSWORD=

# Optional chat automation
CHAT_ENABLED=false
CHAT_MESSAGES=
CHAT_INTERVAL_MS=120000

# Monitoring API
WEB_ENABLED=true
WEB_HOST=0.0.0.0
PORT=3000

# Logging: debug | info | warn | error
LOG_LEVEL=info
